# Syndicate — environment template.
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenRouter key used by the extraction step (backend/intelligence.py) and the
# live Mastra agent.
OPENROUTER_API_KEY=

# Model for grounded extraction and the agent. MUST be non-reasoning: reasoning
# models return content: null, which breaks structured JSON output.
SYNDICATE_LLM_MODEL=deepseek/deepseek-v4.1-flash

# Google Maps: Places Nearby + Geocoding.
GOOGLE_MAPS_API_KEY=

# Anakin MCP: search, scrape, and reddit wire reads.
ANAKIN_API_KEY=

# Optional tuning
SYNDICATE_WORKER_CONCURRENCY=3
SYNDICATE_PENDING_MAX_AGE_S=1800
HELIX_GATEWAY_URL=http://helix:8080